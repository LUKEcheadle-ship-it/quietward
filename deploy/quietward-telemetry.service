[Unit]
Description=QuietWard normalized Linux telemetry helper
After=local-fs.target
Before=quietward.service

[Service]
Type=simple
ExecStart=/usr/local/libexec/quietward-telemetry-helper --socket /run/quietward/telemetry.sock --group %G
RuntimeDirectory=quietward
RuntimeDirectoryMode=0750
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
# The configured monitored scope includes /tmp; a private mount namespace
# would make inotify observe a different filesystem and is therefore unsafe.
PrivateTmp=false
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_CHOWN
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_DAC_READ_SEARCH CAP_CHOWN
LimitNOFILE=128
MemoryMax=64M
TasksMax=32

[Install]
WantedBy=multi-user.target
