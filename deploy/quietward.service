[Unit]
Description=QuietWard observation-only security monitor
After=default.target quietward-telemetry.service

[Service]
Type=simple
ExecStart=%h/.local/share/quietward/bin/quietward run --config %h/.config/quietward/config.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/quietward
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=default.target
