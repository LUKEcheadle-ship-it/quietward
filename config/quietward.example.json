{
  "mode": "observe_only",
  "state_dir": "~/.local/state/quietward",
  "collector": {
    "type": "debian_read_only_v3",
    "interval_seconds": 60,
    "include_processes": true,
    "include_listening_sockets": true,
    "include_outbound_connections": false,
    "include_auth_journal": true,
    "include_docker": true,
    "include_persistence": true,
    "sensitive_files": [
      "/etc/passwd",
      "/etc/group",
      "/etc/sudoers",
      "/etc/ssh/sshd_config",
      "/etc/docker/daemon.json"
    ],
    "max_file_hash_bytes": 4194304,
    "max_persistence_entries": 500,
    "max_docker_inspects": 50,
    "privacy_identity_key_path": "~/.config/quietward/privacy-identity.key",
    "persist_raw_process_arguments": false,
    "persist_raw_source_addresses": false,
    "persist_raw_destination_addresses": false,
    "use_shell": false,
    "use_sudo": false
  },
  "storage": {
    "database_path": "~/.local/state/quietward/quietward.sqlite3",
    "alert_log_path": "~/.local/state/quietward/alerts.jsonl",
    "max_snapshots": 2000,
    "max_events": 100000,
    "max_findings": 25000,
    "retention_days": 30,
    "max_cycles": 2000,
    "max_scanner_runs": 10000,
    "evidence_signing_key_path": null
  },
  "service": {
    "health_path": "~/.local/state/quietward/health.json",
    "lock_path": "~/.local/state/quietward/service.lock",
    "scanner_poll_seconds": 60,
    "stop_after_failures": 10
  },
  "dashboard": {
    "enabled": true,
    "bind": "127.0.0.1",
    "port": 8765,
    "allow_private_network_bind": false
  },
  "self_integrity": {
    "enabled": true,
    "extra_paths": [],
    "max_files": 1000,
    "max_file_bytes": 8388608
  },
  "tiny_model": {
    "enabled": false
  },
  "micro_llm": {
    "enabled": false,
    "endpoint": "http://127.0.0.1:11434",
    "timeout_seconds": 20
  },
  "scanners": [
    {
      "scanner": "clamav",
      "enabled": false,
      "interval_seconds": 86400,
      "timeout_seconds": 1800,
      "targets": ["/home", "/srv"],
      "max_data_age_hours": 72
    },
    {
      "scanner": "yara",
      "enabled": false,
      "interval_seconds": 86400,
      "timeout_seconds": 900,
      "targets": ["/home", "/srv"],
      "rules_path": "/var/lib/quietward/yara/quietward.yar",
      "max_data_age_hours": 720
    },
    {
      "scanner": "trivy",
      "enabled": false,
      "interval_seconds": 86400,
      "timeout_seconds": 1800,
      "targets": ["/srv"],
      "data_source": "~/.cache/trivy",
      "max_data_age_hours": 168
    },
    {
      "scanner": "debsecan",
      "enabled": false,
      "interval_seconds": 86400,
      "timeout_seconds": 300,
      "suite": "bookworm",
      "data_source": "/var/lib/quietward/debsecan/vulnerability-data.json",
      "max_data_age_hours": 72
    }
  ],
  "actions": {
    "execute": false,
    "require_human_approval": true
  },
  "network": {
    "cloud_upload": false,
    "public_listener": false
  }
}
